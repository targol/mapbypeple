# The prototype needs NO environment variables: no API keys, no database, no billing.
# Everything below is optional and only for later phases.

# Where data comes from:
#   local  (default) -> JSON seed in src/data/seed + browser localStorage
#   remote           -> fetch() to VITE_API_BASE_URL (a backend implementing the same /api/... routes)
# VITE_DATA_SOURCE=local
# VITE_API_BASE_URL=https://your-backend.example.com
